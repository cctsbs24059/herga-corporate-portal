<% provide(:title, "Incident ##{@incident.id}") %>

<%# ======================================================== %>
<%# HERGA CORPORATE PORTAL                                  %>
<%# Infrastructure Incident Details                         %>
<%# Phase 2E - Active Directory RBAC Hardening               %>
<%# ======================================================== %>

<% can_manage_incidents = portal_can?(:infrastructure_manage) %>

<div class="container-fluid py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

    <div>
      <h2 class="fw-bold mb-1">
        Incident #<%= @incident.id %>
      </h2>

      <p class="text-muted mb-0">
        <%= @incident.incident_type %>
      </p>
    </div>

    <%= link_to "Back to Incidents",
                infrastructure_incidents_path,
                class: "btn btn-outline-secondary" %>
  </div>

  <div class="row g-4">

    <!-- Main content -->
    <div class="col-lg-8">

      <!-- Incident details -->
      <div class="card shadow-sm mb-4">

        <div class="card-header bg-white py-3">
          <h5 class="mb-0">Incident Details</h5>
        </div>

        <div class="card-body">

          <% status_colour = {
            "Open" => "danger",
            "Acknowledged" => "warning",
            "Resolved" => "success"
          } %>

          <dl class="row mb-0">

            <dt class="col-sm-4">Infrastructure Asset</dt>
            <dd class="col-sm-8">
              <%= link_to @incident.infrastructure_asset.hostname,
                          infrastructure_asset_path(@incident.infrastructure_asset) %>
            </dd>

            <dt class="col-sm-4">Incident Type</dt>
            <dd class="col-sm-8">
              <%= @incident.incident_type %>
            </dd>

            <dt class="col-sm-4">Severity</dt>
            <dd class="col-sm-8">
              <span class="badge bg-<%= @incident.severity == "Critical" ? "danger" : "warning" %>">
                <%= @incident.severity %>
              </span>
            </dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
              <span class="badge bg-<%= status_colour.fetch(@incident.status, "secondary") %>">
                <%= @incident.status %>
              </span>
            </dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">
              <%= @incident.description.presence || "—" %>
            </dd>

            <dt class="col-sm-4">Consecutive Failures</dt>
            <dd class="col-sm-8">
              <%= @incident.consecutive_failures %>
            </dd>

            <dt class="col-sm-4">First Detected</dt>
            <dd class="col-sm-8">
              <%= l(@incident.first_detected_at, format: :long) %>
            </dd>

            <dt class="col-sm-4">Last Observed</dt>
            <dd class="col-sm-8">
              <%= l(@incident.last_observed_at, format: :long) %>
            </dd>

            <dt class="col-sm-4">Assigned To</dt>
            <dd class="col-sm-8">
              <%= @incident.assigned_to&.display_name.presence ||
                  @incident.assigned_to&.username ||
                  "Unassigned" %>
            </dd>

            <dt class="col-sm-4">Acknowledged By</dt>
            <dd class="col-sm-8">
              <%= @incident.acknowledged_by&.username || "—" %>
            </dd>

            <dt class="col-sm-4">Acknowledged At</dt>
            <dd class="col-sm-8">
              <%= @incident.acknowledged_at ?
                  l(@incident.acknowledged_at, format: :long) : "—" %>
            </dd>

            <% if @incident.resolved? %>

              <dt class="col-sm-4">Resolved By</dt>
              <dd class="col-sm-8">
                <%= @incident.resolved_by&.username ||
                    "Automated Monitoring" %>
              </dd>

              <dt class="col-sm-4">Resolved At</dt>
              <dd class="col-sm-8">
                <%= @incident.resolved_at ?
                    l(@incident.resolved_at, format: :long) : "—" %>
              </dd>

              <dt class="col-sm-4">Resolution Reason</dt>
              <dd class="col-sm-8">
                <%= @incident.resolution_reason.presence || "—" %>
              </dd>

              <dt class="col-sm-4">Resolution Note</dt>
              <dd class="col-sm-8">
                <%= @incident.resolution_note.presence || "—" %>
              </dd>

            <% end %>

          </dl>

        </div>
      </div>

      <!-- Audit history -->
      <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
          <h5 class="mb-0">Incident Audit History</h5>
        </div>

        <div class="card-body">

          <% if @events.any? %>

            <% @events.each do |event| %>

              <div class="border-bottom py-3">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                  <strong>
                    <%= event.event_type %>
                  </strong>

                  <span class="small text-muted">
                    <%= l(event.created_at, format: :long) %>
                  </span>

                </div>

                <div class="text-muted mt-2">
                  <%= event.details %>
                </div>

                <div class="small mt-2">
                  <strong>Actor:</strong>
                  <%= event.user&.username ||
                      "Automated Monitoring" %>
                </div>

              </div>

            <% end %>

          <% else %>

            <p class="text-muted mb-0">
              No audit events have been recorded for this incident.
            </p>

          <% end %>

        </div>
      </div>

    </div>

    <!-- Incident management -->
    <div class="col-lg-4">

      <div class="card shadow-sm mb-4"
           id="incident-management">

        <div class="card-header bg-white py-3">

          <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">Incident Management</h5>

            <% if can_manage_incidents %>
              <span class="badge bg-primary">
                Management
              </span>
            <% else %>
              <span class="badge bg-secondary">
                Read Only
              </span>
            <% end %>

          </div>

        </div>

        <div class="card-body">

          <% if @incident.resolved? %>

            <div class="alert alert-success mb-0">
              This incident has been resolved.
            </div>

          <% elsif !can_manage_incidents %>

            <div class="alert alert-secondary mb-0"
                 id="incident-read-only">

              <h6 class="fw-bold">Read-only access</h6>

              <p class="small mb-0">
                Your current Active Directory permissions allow
                you to review incident details and audit history.
                Incident management operations require
                infrastructure management permission.
              </p>

            </div>

          <% else %>

            <% if @incident.status == "Open" %>

              <%= button_to "Acknowledge Incident",
                            acknowledge_infrastructure_incident_path(@incident),
                            method: :patch,
                            class: "btn btn-warning w-100 mb-3",
                            id: "acknowledge-incident-button" %>

            <% end %>

            <% if @incident.unresolved? %>

              <!-- AD-backed assignment -->
              <h6 class="fw-bold">
                Assign Incident
              </h6>

              <p class="small text-muted">
                Assignment is restricted to users with current
                infrastructure management permissions verified
                through Active Directory.
              </p>

              <% unless @assignment_directory_available %>

                <div class="alert alert-warning"
                     id="assignment-directory-unavailable">

                  <strong>Directory verification unavailable</strong>

                  <p class="small mb-0">
                    Assignment is temporarily disabled because
                    candidate eligibility could not be verified.
                  </p>

                </div>

              <% else %>

                <% if @eligible_assignees.empty? %>

                  <div class="alert alert-info"
                       id="no-eligible-assignees">

                    No eligible infrastructure administrators
                    with local portal profiles were found.

                  </div>

                <% else %>

                  <%= form_with url: assign_infrastructure_incident_path(@incident),
                                method: :patch,
                                local: true,
                                id: "incident-assignment-form" do %>

                    <%= select_tag :assigned_to_id,
                        options_from_collection_for_select(
                          @eligible_assignees,
                          :id,
                          :username,
                          @incident.assigned_to_id
                        ),
                        include_blank: "Select eligible assignee",
                        required: true,
                        class: "form-select mb-2" %>

                    <%= submit_tag "Update Assignment",
                                   class: "btn btn-outline-primary w-100 mb-4" %>

                  <% end %>

                  <p class="small text-muted">
                    Eligibility is revalidated when an assignment
                    is submitted.
                  </p>

                <% end %>

              <% end %>

              <hr>

              <!-- Manual resolution -->
              <h6 class="fw-bold">
                Resolve Incident
              </h6>

              <p class="small text-muted">
                Manual resolution requires a reason and will
                suppress recurrence until connectivity is restored.
              </p>

              <%= form_with url: resolve_infrastructure_incident_path(@incident),
                            method: :patch,
                            local: true,
                            id: "incident-resolution-form" do %>

                <%= text_area_tag :resolution_note,
                                  nil,
                                  rows: 4,
                                  required: true,
                                  class: "form-control mb-2",
                                  placeholder: "Enter resolution details..." %>

                <%= submit_tag "Resolve Incident",
                               class: "btn btn-success w-100",
                               data: {
                                 turbo_confirm: "Confirm manual resolution?"
                               } %>

              <% end %>

            <% end %>

          <% end %>

        </div>
      </div>

    </div>

  </div>
</div>