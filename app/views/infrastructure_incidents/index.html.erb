
<% content_for :title, "Infrastructure Incident Register" %>

<%# ============================================================
    HERGA CORPORATE PORTAL
    Phase 2D.6.4 - Infrastructure Incident Management
    Administrator-only Incident Register
    ============================================================ %>

<div class="container-fluid py-4 px-3 px-lg-4"
     style="background:#f5f7fb;min-height:100vh;">

  <%# ======================================================== %>
  <%# PAGE HEADER                                              %>
  <%# ======================================================== %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>
      <h2 class="fw-bold mb-1" style="color:#20334e;">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Infrastructure Incident Register
      </h2>

      <p class="text-muted mb-0">
        HERGA Corporate Portal |
        Infrastructure Operations &amp; Resilience
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

      <%= link_to infrastructure_incidents_path,
                  class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-clockwise me-1"></i>
        Refresh
      <% end %>

      <%= link_to infrastructure_monitoring_path,
                  class: "btn btn-outline-primary" do %>
        <i class="bi bi-activity me-1"></i>
        Monitoring Dashboard
      <% end %>

      <%= link_to infrastructure_assets_path,
                  class: "btn btn-primary" do %>
        <i class="bi bi-hdd-network me-1"></i>
        Asset Inventory
      <% end %>

    </div>

  </div>

  <%# ======================================================== %>
  <%# BREADCRUMBS                                              %>
  <%# ======================================================== %>

  <nav aria-label="breadcrumb" class="mb-4">

    <div class="small">

      <%= link_to "Dashboard",
                  root_path,
                  class: "text-decoration-none" %>

      <span class="text-muted mx-2">/</span>

      <%= link_to "Infrastructure Monitoring",
                  infrastructure_monitoring_path,
                  class: "text-decoration-none" %>

      <span class="text-muted mx-2">/</span>

      <strong style="color:#34465f;">
        Incident Register
      </strong>

    </div>

  </nav>

  <%# ======================================================== %>
  <%# INCIDENT SUMMARY                                         %>
  <%# ======================================================== %>

  <div class="row g-3 mb-4">

    <%
      summary_cards = [
        {
          label: "Total Incidents",
          count: @total_incidents,
          icon: "bi-journal-text",
          color: "#315b9b",
          background: "#edf3fc"
        },
        {
          label: "Open",
          count: @open_count,
          icon: "bi-exclamation-circle",
          color: "#c34646",
          background: "#fceced"
        },
        {
          label: "Acknowledged",
          count: @acknowledged_count,
          icon: "bi-check2-circle",
          color: "#a36a16",
          background: "#fff3df"
        },
        {
          label: "Unresolved",
          count: @unresolved_incident_count,
          icon: "bi-activity",
          color: "#315b9b",
          background: "#edf3fc"
        },
        {
          label: "Critical Unresolved",
          count: @critical_incident_count,
          icon: "bi-exclamation-octagon",
          color: "#c34646",
          background: "#fceced"
        },
        {
          label: "Resolved",
          count: @resolved_count,
          icon: "bi-check-circle",
          color: "#16825d",
          background: "#e7f5ee"
        }
      ]
    %>

    <% summary_cards.each do |card| %>

      <div class="col-12 col-sm-6 col-lg-4 col-xl-2">

        <div class="card h-100"
             style="border:1px solid #dce3ed;border-left:4px solid <%= card[:color] %>;border-radius:10px;box-shadow:0 2px 8px rgba(20,35,60,.045);">

          <div class="card-body p-3">

            <div class="d-flex justify-content-between align-items-start gap-2">

              <div>
                <div class="small text-muted mb-2">
                  <%= card[:label] %>
                </div>

                <h2 class="fw-bold mb-0"
                    style="color:#213550;">
                  <%= card[:count] %>
                </h2>
              </div>

              <div style="width:38px;height:38px;flex-shrink:0;border-radius:9px;background:<%= card[:background] %>;color:<%= card[:color] %>;display:flex;align-items:center;justify-content:center;">

                <i class="bi <%= card[:icon] %> fs-5"></i>

              </div>

            </div>

          </div>

        </div>

      </div>

    <% end %>

  </div>

  <%# ======================================================== %>
  <%# INCIDENT FILTERS                                         %>
  <%# ======================================================== %>

  <div class="card mb-4"
       style="border:1px solid #dce3ed;border-radius:10px;">

    <div class="card-header bg-white py-3">

      <h5 class="mb-0 fw-semibold" style="color:#253955;">
        <i class="bi bi-funnel me-2"></i>
        Incident Filters
      </h5>

    </div>

    <div class="card-body p-4">

      <%= form_with url: infrastructure_incidents_path,
                    method: :get,
                    local: true do %>

        <div class="row g-3 align-items-end">

          <div class="col-12 col-md-6 col-lg-4">

            <label for="incident_status"
                   class="form-label fw-semibold">
              Incident Status
            </label>

            <%= select_tag :status,
                           options_for_select(
                             [
                               ["All Incidents", ""],
                               ["Open", "Open"],
                               ["Acknowledged", "Acknowledged"],
                               ["Resolved", "Resolved"]
                             ],
                             @status_filter
                           ),
                           id: "incident_status",
                           class: "form-select" %>

          </div>

          <div class="col-12 col-md-6 col-lg-4">

            <div class="d-flex flex-wrap gap-2">

              <%= submit_tag "Apply Filter",
                             class: "btn btn-primary" %>

              <%= link_to "Clear",
                          infrastructure_incidents_path,
                          class: "btn btn-outline-secondary" %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  </div>

  <%# ======================================================== %>
  <%# INCIDENT REGISTER                                        %>
  <%# ======================================================== %>

  <div class="card"
       style="border:1px solid #dce3ed;border-radius:10px;overflow:hidden;">

    <div class="card-header bg-white py-3">

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

        <h5 class="mb-0 fw-semibold" style="color:#253955;">

          <i class="bi bi-list-check me-2"></i>
          Registered Infrastructure Incidents

        </h5>

        <span class="badge bg-primary rounded-pill">
          <%= @incidents.total_entries %> Records
        </span>

      </div>

    </div>

    <div class="table-responsive">

      <table class="table table-hover align-middle mb-0"
             style="font-size:13px;">

        <thead class="table-light">

          <tr>
            <th class="py-3 ps-3">Incident</th>
            <th class="py-3">Infrastructure Asset</th>
            <th class="py-3">Type</th>
            <th class="py-3">Severity</th>
            <th class="py-3">Status</th>
            <th class="py-3">Failures</th>
            <th class="py-3">First Detected</th>
            <th class="py-3">Last Observed</th>
            <th class="py-3">Assigned To</th>
            <th class="py-3">Resolution</th>
            <th class="py-3 text-end pe-3">Action</th>
          </tr>

        </thead>

        <tbody>

          <% @incidents.each do |incident| %>

            <%
              severity_class =
                case incident.severity
                when "Critical"
                  "bg-danger"
                when "High"
                  "bg-warning text-dark"
                else
                  "bg-secondary"
                end

              status_class =
                case incident.status
                when "Open"
                  "bg-danger"
                when "Acknowledged"
                  "bg-warning text-dark"
                when "Resolved"
                  "bg-success"
                else
                  "bg-secondary"
                end
            %>

            <tr>

              <td class="ps-3">
                <strong style="color:#253955;">
                  #<%= incident.id %>
                </strong>
              </td>

              <td>

                <% if incident.infrastructure_asset.present? %>

                  <%= link_to(
                        incident.infrastructure_asset.hostname,
                        infrastructure_asset_path(
                          incident.infrastructure_asset
                        ),
                        class: "fw-semibold text-decoration-none"
                      ) %>

                  <% if incident.infrastructure_asset.fqdn.present? %>
                    <div class="small text-muted">
                      <%= incident.infrastructure_asset.fqdn %>
                    </div>
                  <% end %>

                <% else %>

                  <span class="text-muted">
                    Asset unavailable
                  </span>

                <% end %>

              </td>

              <td>
                <%= incident.incident_type %>
              </td>

              <td>
                <span class="badge <%= severity_class %>">
                  <%= incident.severity %>
                </span>
              </td>

              <td>
                <span class="badge <%= status_class %>">
                  <%= incident.status %>
                </span>
              </td>

              <td>
                <%= incident.consecutive_failures %>
              </td>

              <td class="small">
                <% if incident.first_detected_at.present? %>
                  <%= l(
                        incident.first_detected_at,
                        format: :short
                      ) %>
                <% else %>
                  —
                <% end %>
              </td>

              <td class="small">
                <% if incident.last_observed_at.present? %>
                  <%= l(
                        incident.last_observed_at,
                        format: :short
                      ) %>
                <% else %>
                  —
                <% end %>
              </td>

              <td>

                <% if incident.assigned_to.present? %>

                  <span class="small">
                    <%= incident.assigned_to.username %>
                  </span>

                <% else %>

                  <span class="text-muted small">
                    Unassigned
                  </span>

                <% end %>

              </td>

              <td class="small">

                <% if incident.resolution_reason.present? %>
                  <%= incident.resolution_reason %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>

              </td>

              <td class="text-end pe-3">

                <%= link_to(
                      infrastructure_incident_path(incident),
                      class: "btn btn-outline-primary btn-sm",
                      title: "View and manage incident"
                    ) do %>

                  <i class="bi bi-eye me-1"></i>
                  Manage

                <% end %>

              </td>

            </tr>

          <% end %>

          <% if @incidents.empty? %>

            <tr>
              <td colspan="11"
                  class="text-center py-5">

                <div class="text-muted">

                  <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                  <strong>
                    No infrastructure incidents found
                  </strong>

                  <p class="small mt-2 mb-0">
                    There are no incidents matching the
                    selected status filter.
                  </p>

                </div>

              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

    <%# ====================================================== %>
    <%# PAGINATION                                             %>
    <%# ====================================================== %>

    <div class="card-footer bg-white py-3">

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

        <span class="small text-muted">

          <% if @incidents.total_entries.positive? %>

            Showing
            <strong><%= @incidents.offset + 1 %></strong>
            to
            <strong>
              <%= @incidents.offset + @incidents.length %>
            </strong>
            of
            <strong><%= @incidents.total_entries %></strong>
            incidents

          <% else %>

            No incidents to display

          <% end %>

        </span>

        <div>
          <%= will_paginate(
                @incidents,
                renderer: WillPaginate::ActionView::LinkRenderer,
                params: {
                  status: @status_filter
                }
              ) %>
        </div>

      </div>

    </div>

  </div>

  <%# ======================================================== %>
  <%# OPERATIONAL INFORMATION                                  %>
  <%# ======================================================== %>

  <div class="alert alert-light border mt-4 mb-4">

    <div class="d-flex align-items-start gap-2">

      <i class="bi bi-info-circle text-primary mt-1"></i>

      <div class="small">

        <strong>Operational Guidance</strong>

        <p class="mb-1 mt-2">
          Infrastructure incidents are generated from repeated
          unsuccessful connectivity checks.
          An unsuccessful ICMP check does not necessarily
          indicate that a server is offline.
        </p>

        <p class="mb-0">
          Open and Acknowledged incidents remain unresolved
          until formally resolved or cleared through the
          existing incident management workflow.
        </p>

      </div>

    </div>

  </div>

  <%# ======================================================== %>
  <%# FOOTER                                                   %>
  <%# ======================================================== %>

  <div class="text-center text-muted small pb-3">

    HERGA Corporate Portal
    &nbsp; | &nbsp;
    Infrastructure Incident Management
    &nbsp; | &nbsp;
    Administrator Access

  </div>

</div>
