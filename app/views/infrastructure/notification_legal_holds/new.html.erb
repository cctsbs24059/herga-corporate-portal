<% provide(:title, "Register Legal Hold") %>
<div class="container py-4" id="new-notification-legal-hold">
  <h1 class="h3">Register Notification Legal Hold</h1>
  <p class="text-muted">The notification must already exist. Holds cannot be released through this interface.</p>
  <%= form_with model: @hold, scope: :legal_hold, url: infrastructure_notification_legal_holds_path do |f| %>
    <% if @hold.errors.any? %><div class="alert alert-danger"><%= @hold.errors.full_messages.to_sentence %></div><% end %>
    <div class="mb-3"><%= f.label :infrastructure_notification_id, "Notification ID", class: "form-label" %><%= f.number_field :infrastructure_notification_id, min: 1, required: true, class: "form-control" %></div>
    <div class="mb-3"><%= f.label :reference, class: "form-label" %><%= f.text_field :reference, required: true, class: "form-control" %></div>
    <div class="mb-3"><%= f.label :reason, class: "form-label" %><%= f.text_area :reason, rows: 4, required: true, class: "form-control" %></div>
    <%= f.submit "Register Legal Hold", class: "btn btn-primary" %>
    <%= link_to "Cancel", infrastructure_notification_legal_holds_path, class: "btn btn-outline-secondary" %>
  <% end %>
</div>
