<% provide(:title, "Notification Legal Holds") %>
<div class="container-fluid py-4" id="notification-legal-holds">
  <div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h1 class="h3">Notification Legal Holds</h1><div class="d-flex gap-2"><%= link_to "Policies", infrastructure_notification_retention_policies_path, class: "btn btn-outline-secondary" %><%= link_to "Register Hold", new_infrastructure_notification_legal_hold_path, class: "btn btn-primary" %></div></div>
  <div class="alert alert-info">Legal holds preserve notification records. This interface does not release holds or dispose of data.</div>
  <div class="card shadow-sm"><div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th>Reference</th><th>Notification ID</th><th>Reason</th><th>Status</th><th>Placed by</th><th>Placed (UTC)</th></tr></thead><tbody>
    <% @holds.each do |hold| %><tr><td><%= hold.reference %></td><td><%= hold.infrastructure_notification_id %></td><td><%= hold.reason %></td><td><%= hold.active? ? "Active" : "Released" %></td><td><%= hold.placed_by %></td><td><%= hold.placed_at.utc.strftime("%d %b %Y %H:%M") %></td></tr><% end %>
    <% if @holds.empty? %><tr><td colspan="6">No legal holds registered.</td></tr><% end %>
  </tbody></table></div></div>
</div>
