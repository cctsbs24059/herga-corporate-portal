<% provide(:title, "Notification Reporting") %>
<div class="container-fluid py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Notification Reporting &amp; CSV Export</h1>
      <p class="text-muted mb-0">Administrator-only · Read-only · UTC reporting periods</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Notification Centre", infrastructure_notifications_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Analytics", infrastructure_notification_analytics_path, class: "btn btn-outline-primary" %>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold">Report configuration</div>
    <div class="card-body">
      <%= form_with url: infrastructure_notification_reports_path, method: :get, local: true do %>
        <div class="row g-3">
          <div class="col-md-3">
            <%= label_tag :period, "Reporting period", class: "form-label" %>
            <%= select_tag :period, options_for_select({ "Last 24 hours" => "24h", "Last 7 days" => "7d", "Last 30 days" => "30d", "Last 90 days" => "90d" }, @report.period), class: "form-select" %>
          </div>
          <div class="col-md-3">
            <%= label_tag :type, "Report type", class: "form-label" %>
            <%= select_tag :type, options_for_select({ "Notification history" => "history", "Submission attempt audit" => "attempts", "Analytics summary" => "analytics" }, @report.type), class: "form-select" %>
          </div>
          <div class="col-md-3">
            <%= label_tag :status, "Status (optional)", class: "form-label" %>
            <%= select_tag :status, options_for_select([["All statuses", ""]] + InfrastructureNotification::STATUSES.map { |value| [value, value] }, @report.status), class: "form-select" %>
          </div>
          <div class="col-md-3">
            <%= label_tag :event_type, "Event type (optional)", class: "form-label" %>
            <%= select_tag :event_type, options_for_select([["All events", ""]] + InfrastructureNotification::EVENTS.map { |value| [value, value] }, @report.event_type), class: "form-select" %>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <%= button_tag "Preview selection", type: "submit", class: "btn btn-outline-primary" %>
          <%= button_tag "Download CSV", type: "submit", name: "format", value: "csv", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Notifications created in selected period</div>
      <div class="h3 mb-0"><%= @report.history_count %></div>
    </div></div></div>
    <div class="col-md-6"><div class="card shadow-sm"><div class="card-body">
      <div class="text-muted small">Submission attempts in selected period</div>
      <div class="h3 mb-0"><%= @report.attempts_count %></div>
    </div></div></div>
  </div>

  <div class="alert alert-info" role="note">
    <strong>Reporting interpretation:</strong> Accepted means Microsoft Graph accepted the submission, not confirmed recipient delivery.
    Unknown indicates an indeterminate outcome. Exports exclude recipient addresses, raw error details, message bodies and credentials.
    History and analytics use notification creation time; attempt audits use attempt time.
    Detail exports are capped at <%= Infrastructure::NotificationReportExport::MAX_ROWS %> rows. A summary export is aggregated and is not subject to this row cap.
  </div>
</div>
