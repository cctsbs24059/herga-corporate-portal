<% provide(:title, "Notification Operational Analytics") %>
<div class="container-fluid py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Notification Operational Analytics</h1>
      <p class="text-muted mb-0">Read-only operational reporting · UTC reporting periods</p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "Notification Centre", infrastructure_notifications_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Refresh", infrastructure_notification_analytics_path(period: @period), class: "btn btn-outline-primary" %>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-2">
      <strong class="me-2">Reporting period:</strong>
      <% { "24h" => "24 hours", "7d" => "7 days", "30d" => "30 days", "90d" => "90 days" }.each do |value, label| %>
        <%= link_to label, infrastructure_notification_analytics_path(period: value), class: "btn btn-sm #{@period == value ? 'btn-primary' : 'btn-outline-primary'}" %>
      <% end %>
      <span class="ms-auto small text-muted"><%= @analytics[:since].utc.strftime("%d %b %Y %H:%M") %> – <%= @analytics[:until_at].utc.strftime("%d %b %Y %H:%M") %> UTC</span>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <% [
      ["Notifications created", @analytics[:total]],
      ["Graph accepted (current status)", @analytics[:statuses]["Accepted"]],
      ["Unknown outcomes (current status)", @analytics[:statuses]["Unknown"]],
      ["Pending", @analytics[:statuses]["Pending"]],
      ["Sending", @analytics[:statuses]["Sending"]],
      ["Acceptance share", "#{@analytics[:accepted_percentage]}%"]
    ].each do |label, value| %>
      <div class="col-sm-6 col-xl-4"><div class="card h-100 shadow-sm"><div class="card-body">
        <div class="text-muted small"><%= label %></div><div class="h3 mb-0"><%= value %></div>
      </div></div></div>
    <% end %>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-semibold">Notification event types</div>
      <div class="table-responsive"><table class="table table-striped mb-0"><thead><tr><th scope="col">Event</th><th scope="col" class="text-end">Count</th></tr></thead><tbody>
      <% @analytics[:events].each do |event, count| %><tr><td><%= event %></td><td class="text-end"><%= count %></td></tr><% end %>
      </tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-header fw-semibold">Recorded submission attempts</div>
      <div class="card-body"><dl class="row mb-0">
        <dt class="col-8">Total recorded attempts</dt><dd class="col-4 text-end"><%= @analytics[:attempts][:total] %></dd>
        <dt class="col-8">Accepted attempts</dt><dd class="col-4 text-end"><%= @analytics[:attempts][:accepted] %></dd>
        <dt class="col-8">Unknown attempts</dt><dd class="col-4 text-end"><%= @analytics[:attempts][:unknown] %></dd>
        <dt class="col-8">Average recorded processing interval</dt><dd class="col-4 text-end"><%= @analytics[:average_processing_seconds] ? "#{@analytics[:average_processing_seconds]} s" : "N/A" %></dd>
      </dl></div></div></div>
  </div>

  <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Daily notification activity (UTC)</div>
    <div class="table-responsive"><table class="table table-hover mb-0" id="notification-analytics-daily-table">
      <thead><tr><th scope="col">Date (UTC)</th><% InfrastructureNotification::STATUSES.each do |status| %><th scope="col" class="text-end"><%= status %></th><% end %></tr></thead>
      <tbody><% if @analytics[:daily].empty? %><tr><td colspan="5" class="text-center text-muted py-4">No notifications in this reporting period.</td></tr><% else %>
        <% @analytics[:daily].each do |date, statuses| %><tr><td><%= date %></td><% InfrastructureNotification::STATUSES.each do |status| %><td class="text-end"><%= statuses[status] %></td><% end %></tr><% end %>
      <% end %></tbody>
    </table></div>
  </div>
  <div class="alert alert-info" role="note">
    <strong>Interpretation:</strong> Accepted means Microsoft Graph accepted a submission, not confirmed recipient delivery.
    Unknown indicates an indeterminate outcome. Notification status and event breakdowns reflect records created in the selected period and their current statuses; attempt counts reflect attempts recorded during the period. Processing interval is calculated from recorded attempt and acceptance timestamps where valid, not end-to-end delivery time.
  </div>
</div>
