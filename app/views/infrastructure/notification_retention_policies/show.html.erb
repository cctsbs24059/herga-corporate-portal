<% provide(:title, "Retention Policy") %>
<div class="container-fluid py-4" id="retention-policy-detail">
  <div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><h1 class="h3"><%= @policy.name %></h1><%= link_to "All Policies", infrastructure_notification_retention_policies_path, class: "btn btn-outline-secondary" %></div>
  <div class="alert alert-warning">Approval is not disposal authorisation. No deletion or archival operations are available.</div>
  <div class="card shadow-sm mb-4"><div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Reference</dt><dd class="col-sm-9"><%= @policy.reference %></dd>
      <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><%= @policy.status %></dd>
      <dt class="col-sm-3">Retention period</dt><dd class="col-sm-9"><%= @policy.retention_days %> days</dd>
      <dt class="col-sm-3">Version</dt><dd class="col-sm-9"><%= @policy.version %></dd>
      <dt class="col-sm-3">Approved by</dt><dd class="col-sm-9"><%= @policy.approved_by.presence || "Not approved" %></dd>
      <dt class="col-sm-3">Approved at</dt><dd class="col-sm-9"><%= @policy.approved_at&.utc&.strftime("%d %b %Y %H:%M UTC") || "—" %></dd>
    </dl>
  </div></div>
  <% if @policy.status == "Draft" %>
    <div class="card mb-4"><div class="card-body">
      <h2 class="h5">Approve draft</h2><p class="small text-muted">Enter the exact policy reference to confirm. This is not independent second-person approval.</p>
      <%= form_with url: approve_infrastructure_notification_retention_policy_path(@policy), method: :patch do |f| %>
        <%= f.label :approval_reference, "Policy reference", class: "form-label" %>
        <%= f.text_field :approval_reference, required: true, class: "form-control mb-2", autocomplete: "off" %>
        <%= f.submit "Approve Policy", class: "btn btn-primary", data: { turbo_confirm: "Approve this policy? This does not authorise disposal." } %>
      <% end %>
    </div></div>
  <% elsif @policy.status == "Approved" %>
    <%= button_to "Suspend Policy", suspend_infrastructure_notification_retention_policy_path(@policy), method: :patch, class: "btn btn-outline-danger mb-4", data: { turbo_confirm: "Suspend this policy?" } %>
  <% end %>
  <h2 class="h5">Audit History</h2>
  <div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Time (UTC)</th><th>Action</th><th>Actor</th><th>From</th><th>To</th><th>Version</th></tr></thead><tbody>
    <% @events.each do |event| %><tr><td><%= event.created_at.utc.strftime("%d %b %Y %H:%M") %></td><td><%= event.action %></td><td><%= event.actor %></td><td><%= event.from_status || "—" %></td><td><%= event.to_status %></td><td><%= event.policy_version %></td></tr><% end %>
  </tbody></table></div></div>
</div>
