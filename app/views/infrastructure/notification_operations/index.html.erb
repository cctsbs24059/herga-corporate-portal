
<%# frozen_string_literal: true %>
<% provide(:title, "Notification Operations") %>

<div class="container-fluid py-4">

  <%# PAGE HEADER %>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">
        <i class="bi bi-speedometer2 me-2"></i>
        Notification Operations
      </h1>
      <p class="text-muted mb-0">
        Read-only operational overview of Microsoft Graph submissions,
        notification processing, service health and retention.
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to infrastructure_notifications_path,
                  class: "btn btn-outline-secondary" do %>
        <i class="bi bi-envelope-paper me-1"></i>
        Notification Centre
      <% end %>

      <%= link_to infrastructure_notification_retention_path,
                  class: "btn btn-outline-secondary" do %>
        <i class="bi bi-archive me-1"></i>
        Retention Assessment
      <% end %>

      <%= link_to infrastructure_notification_operations_path(period: @period),
                  class: "btn btn-outline-primary" do %>
        <i class="bi bi-arrow-clockwise me-1"></i>
        Refresh
      <% end %>
    </div>
  </div>

  <%# SERVICE STATUS AND REPORTING PERIOD %>
  <div class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">

      <div>
        <strong>Notification service:</strong>
        <span class="badge <%= @notification_enabled ? 'bg-success' : 'bg-secondary' %>">
          <%= @notification_enabled ? "Enabled" : "Disabled" %>
        </span>
      </div>

      <div class="small text-muted">
        Activated:
        <%= @notification_activation_time ?
              @notification_activation_time.utc.strftime("%d %b %Y %H:%M UTC") :
              "Not configured" %>
      </div>

      <div class="ms-auto d-flex flex-wrap gap-2 align-items-center">
        <span class="small fw-semibold">Reporting period:</span>

        <% {
          "24h" => "24 hours",
          "7d"  => "7 days",
          "30d" => "30 days",
          "90d" => "90 days"
        }.each do |value, label| %>
          <%= link_to label,
                      infrastructure_notification_operations_path(period: value),
                      class: "btn btn-sm #{@period == value ? 'btn-primary' : 'btn-outline-primary'}" %>
        <% end %>
      </div>

    </div>

    <div class="card-footer small text-muted">
      <i class="bi bi-calendar-range me-1"></i>
      Notification metrics:
      <%= @analytics[:since].utc.strftime("%d %b %Y %H:%M") %>
      to
      <%= @analytics[:until_at].utc.strftime("%d %b %Y %H:%M") %>
      UTC (by record creation time).
    </div>
  </div>

  <%# PHASE 2D.8.4.3.8 — OPERATIONAL HEALTH INDICATORS %>
  <%= render "health_indicators",
             health_assessment: @health_assessment %>

  <%# NOTIFICATION ACTIVITY %>
  <h2 class="h5 mb-3">
    <i class="bi bi-graph-up-arrow me-2"></i>
    Notification activity
  </h2>

  <div class="row g-3 mb-4" id="notification-operations-kpis">

    <% [
      ["Notifications created", @analytics[:total], "primary"],
      ["Graph accepted", @analytics[:statuses].fetch("Accepted", 0), "success"],
      ["Unknown outcomes", @analytics[:statuses].fetch("Unknown", 0), "danger"],
      ["Pending", @analytics[:statuses].fetch("Pending", 0), "warning"],
      ["Sending", @analytics[:statuses].fetch("Sending", 0), "info"],
      ["Acceptance share", "#{@analytics[:accepted_percentage]}%", "primary"]
    ].each do |label, value, colour| %>

      <div class="col-sm-6 col-xl-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="small text-muted"><%= label %></div>
            <div class="h3 mb-0 mt-2 text-<%= colour %>">
              <%= value.is_a?(Numeric) ? number_with_delimiter(value) : value %>
            </div>
          </div>
        </div>
      </div>

    <% end %>
  </div>

  <%# BACKGROUND JOB AND QUEUE DIAGNOSTICS %>
  <div class="row g-3 mb-4">

    <div class="col-lg-6">
      <div class="card shadow-sm h-100" id="notification-operations-jobs">
        <div class="card-header fw-semibold">
          <i class="bi bi-cpu me-2"></i>
          Notification-specific job diagnostics
        </div>

        <div class="card-body">
          <% if @job_diagnostics[:available] %>
            <p class="mb-3">
              Status:
              <span class="badge <%= case @job_diagnostics[:status]
                when "Healthy" then "bg-success"
                when "Degraded" then "bg-warning text-dark"
                else "bg-danger"
              end %>">
                <%= @job_diagnostics[:status] %>
              </span>
            </p>

            <dl class="row mb-0">
              <% [
                ["Healthy workers", :healthy_workers],
                ["Ready jobs", :ready_count],
                ["Running jobs", :running_count],
                ["Scheduled jobs", :scheduled_count],
                ["All recorded failed jobs", :total_failed_count],
                ["Failed in last 24 hours", :recent_failed_count]
              ].each do |label, key| %>
                <dt class="col-8"><%= label %></dt>
                <dd class="col-4 text-end">
                  <%= @job_diagnostics[key] %>
                </dd>
              <% end %>
            </dl>
          <% else %>
            <div class="alert alert-warning mb-0" role="status">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Notification job diagnostics are temporarily unavailable.
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm h-100" id="notification-operations-queue">
        <div class="card-header fw-semibold">
          <i class="bi bi-hdd-network me-2"></i>
          Overall Solid Queue health
        </div>

        <div class="card-body">
          <% if @queue_health[:available] %>
            <p class="mb-3">
              Status:
              <strong><%= @queue_health[:overall_status] %></strong>
            </p>

            <dl class="row mb-0">
              <dt class="col-8">Healthy workers / total</dt>
              <dd class="col-4 text-end">
                <%= @queue_health[:healthy_worker_count] %>
                /
                <%= @queue_health[:worker_count] %>
              </dd>

              <% [
                ["Pending jobs (all queues)", :pending_jobs],
                ["Running jobs (all queues)", :running_jobs],
                ["Failed jobs (all queues)", :failed_jobs]
              ].each do |label, key| %>
                <dt class="col-8"><%= label %></dt>
                <dd class="col-4 text-end"><%= @queue_health[key] %></dd>
              <% end %>

              <dt class="col-8">Reconciliation task registered</dt>
              <dd class="col-4 text-end">
                <%= @queue_health[:reconciliation_registered] ? "Yes" : "No" %>
              </dd>
            </dl>
          <% else %>
            <div class="alert alert-warning mb-0" role="status">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Overall queue health is temporarily unavailable.
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <%# OPERATIONAL MODULES %>
  <h2 class="h5 mb-3">
    <i class="bi bi-grid me-2"></i>
    Operational modules
  </h2>

  <div class="row g-3 mb-4" id="notification-operations-modules">

    <% [
      [
        "Notification Centre",
        "Inspect individual notification records, current status and submission attempts.",
        infrastructure_notifications_path,
        "bi-envelope-paper"
      ],
      [
        "Analytics & Trends",
        "Review event breakdowns, attempt counts and UTC daily activity.",
        infrastructure_notification_analytics_path(period: @period),
        "bi-bar-chart"
      ],
      [
        "Failure Investigation",
        "Investigate failed notification background jobs.",
        infrastructure_notification_job_failures_path,
        "bi-exclamation-triangle"
      ],
      [
        "CSV Reporting",
        "Download administrator-only history, attempts and analytics exports.",
        infrastructure_notification_reports_path(period: @period),
        "bi-file-earmark-spreadsheet"
      ],
      [
        "Retention Assessment",
        "Review notification age, retention eligibility and protected audit records without deleting data.",
        infrastructure_notification_retention_path,
        "bi-archive"
      ]
    ].each do |name, description, destination, icon| %>

      <div class="col-md-6 col-xl-4">
        <div class="card shadow-sm h-100">
          <div class="card-body d-flex flex-column">
            <h3 class="h6">
              <i class="bi <%= icon %> me-2"></i>
              <%= name %>
            </h3>

            <p class="small text-muted">
              <%= description %>
            </p>

            <%= link_to destination,
                        class: "btn btn-sm btn-outline-primary mt-auto" do %>
              <i class="bi bi-box-arrow-up-right me-1"></i>
              Open module
            <% end %>
          </div>
        </div>
      </div>

    <% end %>
  </div>

  <%# OPERATIONAL INTERPRETATION %>
  <div class="alert alert-light border small" role="note">
    <div class="fw-semibold mb-2">
      <i class="bi bi-info-circle me-1"></i>
      Operational interpretation
    </div>

    <p class="mb-2">
      <strong>Accepted</strong> means Microsoft Graph accepted the
      submission. It does not confirm recipient delivery.
    </p>

    <p class="mb-2">
      <strong>Unknown</strong> represents an indeterminate submission
      outcome, not a confirmed failure. Investigate before considering
      any resend.
    </p>

    <p class="mb-2">
      Notification activity metrics reflect records created within
      the selected reporting period and their current statuses.
      Operational health and retention assessments may use
      different time windows and thresholds.
    </p>

    <p class="mb-2">
      Retention eligibility is an assessment only.
      The configured retention period is provisional and must not
      be treated as an approved corporate records policy.
    </p>

    <p class="mb-0">
      Job failure counts are independent of notification status.
      This dashboard does not resend notifications, delete records
      or perform archival operations.
    </p>
  </div>

</div>
