<% content_for :title, "Infrastructure Inventory" %>

<div class="container-fluid py-4 px-3 px-lg-4">

  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1">Infrastructure Inventory</h2>
      <p class="text-muted mb-0">
        HERGA.NET Enterprise Infrastructure Management
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <%= button_to sync_active_directory_infrastructure_assets_path,
          method: :post,
          class: "btn btn-outline-primary",
          form: {
            data: {
              turbo_confirm: "Synchronize Windows Servers from HERGA.NET Active Directory?"
            }
          } do %>
        <i class="bi bi-arrow-repeat me-1"></i>
        Synchronize AD Servers
      <% end %>

      <%= button_to check_all_connectivity_infrastructure_assets_path,
          method: :post,
          disabled: @active_monitoring_run.present?,
          class: "btn btn-outline-success",
          form: {
            data: {
              turbo_confirm: "Start connectivity monitoring for all non-retired assets?"
            }
          } do %>
        <i class="bi bi-activity me-1"></i>
        <%= @active_monitoring_run.present? ? "Monitoring in Progress" : "Check All Servers" %>
      <% end %>

      <%= link_to new_infrastructure_asset_path,
          class: "btn btn-primary" do %>
        <i class="bi bi-plus-circle me-1"></i>
        Register Infrastructure Asset
      <% end %>
    </div>
  </div>

  <!-- Asset Summary -->
  <div class="row g-3 mb-4">
    <% [
      ["Total Infrastructure Assets", @total_assets, "bi-hdd-network", "text-dark"],
      ["Active Directory Assets", @ad_assets, "bi-diagram-3", "text-primary"],
      ["Manually Registered", @manual_assets, "bi-plus-square", "text-dark"],
      ["Retired Assets", @retired_assets, "bi-archive", "text-secondary"]
    ].each do |label, count, icon, color| %>
      <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4">
            <div class="small text-muted mb-2">
              <i class="bi <%= icon %> me-1"></i>
              <%= label %>
            </div>
            <h2 class="fw-bold mb-0 <%= color %>">
              <%= count %>
            </h2>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Health classification based on the most recent monitoring results -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="fw-bold mb-0"><i class="bi bi-heart-pulse me-2"></i>Infrastructure Health</h5>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <% [
          ["Healthy", "success", "bi-check-circle"],
          ["Warning", "warning", "bi-exclamation-triangle"],
          ["Critical", "danger", "bi-exclamation-octagon"],
          ["Unknown", "secondary", "bi-question-circle"],
          ["Not Monitored", "secondary", "bi-dash-circle"]
        ].each do |name, color, icon| %>
          <div class="col-sm-6 col-lg">
            <div class="border rounded p-3 h-100">
              <div class="small text-muted mb-2"><i class="bi <%= icon %> me-1"></i><%= name %></div>
              <h3 class="fw-bold text-<%= color %> mb-0"><%= @health_counts[name] %></h3>
            </div>
          </div>
        <% end %>
      </div>
      <p class="small text-muted mt-3 mb-0">
        Health is inferred from recent DNS/ICMP monitoring; a failed ping does not prove a server is offline.
        Stale checks (over 45 minutes) are classified Unknown. Retired assets are Not Monitored.
      </p>
    </div>
  </div>

  <!-- Enterprise Connectivity Overview -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-activity me-2"></i>
        Enterprise Connectivity Overview
      </h5>
      <span class="small text-muted">
        <% if @last_connectivity_check.present? %>
          Latest check:
          <%= l(@last_connectivity_check, format: :long) %>
        <% else %>
          No connectivity checks recorded
        <% end %>
      </span>
    </div>

    <div class="card-body p-4">
      <div class="row g-3">
        <% [
          ["Reachable", @reachable_assets, "success", "bi-check-circle"],
          ["Unreachable", @unreachable_assets, "danger", "bi-x-circle"],
          ["Unknown", @unknown_assets, "secondary", "bi-question-circle"],
          ["Not Checked", @not_checked_assets, "secondary", "bi-clock-history"]
        ].each do |label, count, color, icon| %>
          <div class="col-md-6 col-xl-3">
            <div class="border rounded p-3 h-100">
              <div class="small text-muted mb-2">
                <i class="bi <%= icon %> me-1"></i>
                <%= label %>
              </div>
              <h2 class="fw-bold text-<%= color %> mb-0">
                <%= count %>
              </h2>
            </div>
          </div>
        <% end %>
      </div>

      <div class="small text-muted mt-3">
        <i class="bi bi-info-circle me-1"></i>
        Results reflect the latest checks from the HERGA Portal application
        server. ICMP failures do not necessarily mean a server is offline.
      </div>
    </div>
  </div>

  <!-- Automated Monitoring Configuration -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-calendar-check me-2"></i>
        Automated Infrastructure Monitoring
      </h5>
    </div>
    <div class="card-body p-4">
      <div class="row g-3 align-items-center">
        <div class="col-md-4">
          <div class="small text-muted mb-1">Scheduled monitoring</div>
          <span class="badge <%= @scheduled_monitoring_enabled ? 'bg-success' : 'bg-secondary' %>">
            <%= @scheduled_monitoring_enabled ? 'Enabled in application' : 'Disabled' %>
          </span>
        </div>
        <div class="col-md-4">
          <div class="small text-muted mb-1">Configured interval</div>
          <strong>Every <%= @monitoring_interval_minutes %> minutes</strong>
        </div>
        <div class="col-md-4">
          <div class="small text-muted mb-1">Last completed run</div>
          <% if @last_completed_monitoring_run.present? %>
            <strong>#<%= @last_completed_monitoring_run.id %></strong>
            <div class="small text-muted">
              <%= l(@last_completed_monitoring_run.completed_at || @last_completed_monitoring_run.updated_at, format: :short) %>
            </div>
          <% else %>
            <span class="text-muted">None recorded</span>
          <% end %>
        </div>
      </div>
      <div class="small text-muted mt-3">
        <i class="bi bi-info-circle me-1"></i>
        Enabled status reflects the application environment variable, not live scheduler health.
        Recurring checks require the Solid Queue scheduler and worker to remain running.
        The interval is configured in <code>config/recurring.yml</code>.
      </div>
    </div>
  </div>

  <!-- Active Monitoring Run -->
  <% if @active_monitoring_run.present? %>
    <div class="card border-primary shadow-sm mb-4">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-arrow-repeat me-2"></i>
            Monitoring Run #<%= @active_monitoring_run.id %>
          </h5>
          <span class="badge bg-primary">
            <%= @active_monitoring_run.status %>
          </span>
        </div>

        <div class="progress mb-3"
             role="progressbar"
             aria-label="Monitoring progress"
             aria-valuenow="<%= @active_monitoring_run.progress_percentage %>"
             aria-valuemin="0"
             aria-valuemax="100">
          <div class="progress-bar progress-bar-striped progress-bar-animated"
               style="width: <%= @active_monitoring_run.progress_percentage %>%">
            <%= @active_monitoring_run.progress_percentage %>%
          </div>
        </div>

        <div class="small text-muted">
          <%= @active_monitoring_run.processed_assets %>
          of
          <%= @active_monitoring_run.total_assets %>
          assets processed.
          Refresh this page to update progress.
        </div>
      </div>
    </div>
  <% end %>

  <!-- Recent Monitoring Runs -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center">
      <strong>
        <i class="bi bi-clock-history me-2"></i>
        Recent Monitoring Runs
      </strong>
      <span class="badge bg-secondary">
        <%= @historical_check_count %> Historical Checks
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Run</th>
            <th>Started / Queued</th>
            <th>Status</th>
            <th>Processed</th>
            <th>Reachable</th>
            <th>Unreachable</th>
            <th>Unknown</th>
            <th>Errors</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_monitoring_runs.each do |run| %>
            <tr>
              <td>#<%= run.id %></td>
              <td>
                <%= l(run.started_at || run.created_at, format: :short) %>
              </td>
              <td>
                <% run_badge =
                    case run.status
                    when "Completed" then "bg-success"
                    when "Failed" then "bg-danger"
                    when "Running" then "bg-primary"
                    else "bg-secondary"
                    end %>
                <span class="badge <%= run_badge %>">
                  <%= run.status %>
                </span>
              </td>
              <td><%= run.processed_assets %> / <%= run.total_assets %></td>
              <td><%= run.reachable_assets %></td>
              <td><%= run.unreachable_assets %></td>
              <td><%= run.unknown_assets %></td>
              <td><%= run.failed_checks %></td>
            </tr>
          <% end %>

          <% if @recent_monitoring_runs.empty? %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">
                No monitoring runs recorded yet.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Operating System and Classification -->
  <div class="row g-4 mb-4">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <strong>
            <i class="bi bi-windows me-2"></i>
            Operating System Breakdown
          </strong>
        </div>
        <div class="card-body p-4">
          <% @os_breakdown.each do |os, count| %>
            <% percentage = @total_assets.positive? ? (count.to_f / @total_assets * 100).round(1) : 0 %>
            <div class="mb-3">
              <div class="d-flex justify-content-between mb-2">
                <span class="small"><%= os %></span>
                <strong class="small"><%= count %></strong>
              </div>
              <div class="progress"
                   role="progressbar"
                   aria-label="<%= os %>"
                   aria-valuenow="<%= percentage %>"
                   aria-valuemin="0"
                   aria-valuemax="100">
                <div class="progress-bar"
                     style="width: <%= percentage %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <strong>
            <i class="bi bi-diagram-2 me-2"></i>
            Infrastructure Classification
          </strong>
        </div>
        <div class="card-body p-4">
          <% if @asset_type_breakdown.any? %>
            <% @asset_type_breakdown.each do |type, count| %>
              <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <span><%= type %></span>
                <span class="badge bg-primary rounded-pill">
                  <%= count %>
                </span>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">No assets registered.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Synchronization Information -->
  <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-centergap-2 mb-4">
    <div>
      <i class="bi bi-clock-history me-2"></i>
      <strong>Latest AD Asset Synchronization:</strong>
      <% if @last_ad_sync.present? %>
        <%= l(@last_ad_sync, format: :long) %>
      <% else %>
        Not yet synchronized
      <% end %>
    </div>
    <span class="badge bg-secondary">
      Read-only Active Directory Discovery
    </span>
  </div>

  <!-- Search -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <%= form_with url: infrastructure_assets_path,
                    method: :get,
                    local: true do %>
        <div class="row g-3 align-items-end">
          <div class="col-lg-5">
            <label class="form-label">Search Infrastructure</label>
            <%= text_field_tag :q, @query,
                class: "form-control",
                placeholder: "Hostname, DNS, IP address or description" %>
          </div>

          <div class="col-lg-3">
            <label class="form-label">Asset Type</label>
            <%= select_tag :asset_type,
                options_for_select(
                  [["All Asset Types", ""]] +
                  InfrastructureAsset::ASSET_TYPES.map { |type| [type, type] },
                  @asset_type
                ),
                class: "form-select" %>
          </div>

          <div class="col-lg-2">
            <label class="form-label">Status</label>
            <%= select_tag :status,
                options_for_select(
                  [["All Statuses", ""]] +
                  InfrastructureAsset::STATUSES.map { |status| [status, status] },
                  @status
                ),
                class: "form-select" %>
          </div>

          <div class="col-lg-2">
            <%= submit_tag "Search", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Infrastructure Inventory Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <strong>Registered Infrastructure Assets</strong>
      <span class="badge bg-primary">
        <%= @total_count %> Assets
      </span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Hostname</th>
            <th>IP Address</th>
            <th>Operating System</th>
            <th>Asset Type</th>
            <th>Environment</th>
            <th>Source</th>
            <th>Lifecycle</th>
            <th>Health</th>
            <th>ICMP Success</th>
            <th>DNS</th>
            <th>ICMP</th>
            <th>Latency</th>
            <th>Last Checked</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>

        <tbody>
          <% @assets.each do |asset| %>
            <tr>
              <td>
                <strong><%= asset.hostname %></strong>
                <div class="small text-muted"><%= asset.fqdn %></div>
              </td>
              <td>
                <%= asset.ip_address.presence ||
                    asset.resolved_ip_address.presence || "—" %>
              </td>
              <td><%= asset.operating_system.presence || "—" %></td>
              <td><%= asset.asset_type %></td>
              <td><%= asset.environment %></td>

              <td>
                <span class="badge bg-<%= asset.source == 'Active Directory' ? 'primary' : 'secondary' %>">
                  <%= asset.source %>
                </span>
              </td>

              <td>
                <% lifecycle_class =
                    case asset.status
                    when "Active" then "bg-success"
                    when "Maintenance" then "bg-warning text-dark"
                    else "bg-secondary"
                    end %>
                <span class="badge <%= lifecycle_class %>">
                  <%= asset.status %>
                </span>
              </td>

              <% health = @health_by_asset_id[asset.id] %>
              <% health_color = { "Healthy" => "success", "Warning" => "warning text-dark", "Critical" => "danger", "Unknown" => "secondary", "Not Monitored" => "secondary" }.fetch(health&.status, "secondary") %>
              <td><span class="badge bg-<%= health_color %>" title="<%= health&.reason %>"><%= health&.status || "Unknown" %></span></td>
              <td class="small">
                <% if @availability_by_asset_id.key?(asset.id) %>
                  <%= number_with_precision(@availability_by_asset_id[asset.id], precision: 1) %>%
                <% else %>
                  —
                <% end %>
              </td>

              <td>
                <% dns_class =
                    case asset.dns_status
                    when "Resolved" then "bg-success"
                    when "Failed" then "bg-danger"
                    else "bg-secondary"
                    end %>
                <span class="badge <%= dns_class %>">
                  <%= asset.dns_status.presence || "Not Checked" %>
                </span>
              </td>

              <td>
                <% icmp_class =
                    case asset.icmp_status
                    when "Reachable" then "bg-success"
                    when "Unreachable" then "bg-danger"
                    else "bg-secondary"
                    end %>
                <span class="badge <%= icmp_class %>">
                  <%= asset.icmp_status.presence || "Not Checked" %>
                </span>
              </td>

              <td>
                <% if asset.icmp_response_ms.present? %>
                  <%= number_with_precision(asset.icmp_response_ms, precision: 2) %> ms
                <% else %>
                  —
                <% end %>
              </td>

              <td class="small text-muted">
                <% if asset.last_connectivity_check_at.present? %>
                  <%= l(asset.last_connectivity_check_at, format: :short) %>
                <% else %>
                  Never
                <% end %>
              </td>

              <td class="text-end">
                <%= link_to "View",
                    infrastructure_asset_path(asset),
                    class: "btn btn-outline-primary btn-sm" %>
              </td>
            </tr>
          <% end %>

          <% if @assets.empty? %>
            <tr>
              <td colspan="14" class="text-center text-muted py-5">
                No infrastructure assets found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="card-footer bg-white d-flex justify-content-between align-items-center">
      <span class="small text-muted">
        Page <%= @page %> of <%= @total_pages %>
      </span>

      <div class="btn-group">
        <% if @page > 1 %>
          <%= link_to "Previous",
              infrastructure_assets_path(
                q: @query,
                asset_type: @asset_type,
                status: @status,
                page: @page - 1
              ),
              class: "btn btn-outline-secondary btn-sm" %>
        <% end %>

        <% if @page < @total_pages %>
          <%= link_to "Next",
              infrastructure_assets_path(
                q: @query,
                asset_type: @asset_type,
                status: @status,
                page: @page + 1
              ),
              class: "btn btn-outline-secondary btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to "Back to Corporate Dashboard",
        root_path,
        class: "btn btn-outline-secondary" %>
  </div>

</div>
