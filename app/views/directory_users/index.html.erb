
<% content_for :title, "HERGA | Active Directory Users" %>

<% users = @users || [] %>

<% enabled_count = @enabled_count || 0 %>
<% disabled_count = @disabled_count || 0 %>
<% unknown_count = @unknown_count || 0 %>

<div class="container-fluid bg-light min-vh-100 py-4 px-3 px-lg-4">

  <!-- PAGE HEADER -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold text-dark mb-1">
        Active Directory Users
      </h2>
      <p class="text-muted mb-0">
        HERGA.NET Corporate Directory
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Corporate Dashboard",
          root_path,
          class: "btn btn-outline-secondary" %>

      <%= link_to "Refresh Directory",
          directory_users_path(q: @query.presence),
          class: "btn btn-outline-primary" %>
    </div>
  </div>

  <!-- DIRECTORY BANNER -->
  <div class="card bg-primary text-white border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-lg-9">
          <h4 class="fw-bold mb-2">
            HERGA.NET Active Directory
          </h4>
          <p class="mb-0 opacity-75">
            Browse corporate user accounts, review account status,
            and inspect Active Directory security group memberships.
          </p>
        </div>

        <div class="col-lg-3 text-lg-end">
          <span class="badge bg-light text-primary px-3 py-2">
            Read-Only Access
          </span>
          <div class="small mt-2 opacity-75">
            Administrator Module
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- DIRECTORY STATISTICS -->
  <div class="row g-3 mb-4">

    <% [
      {
        title: "Users Returned",
        value: @user_count || users.length,
        colour: "primary",
        description: "Maximum 100 per search"
      },
      {
        title: "Enabled Accounts",
        value: enabled_count,
        colour: "success",
        description: "Enabled in returned results"
      },
      {
        title: "Disabled Accounts",
        value: disabled_count,
        colour: "secondary",
        description: "Disabled in returned results"
      },
      {
        title: "Unknown Status",
        value: unknown_count,
        colour: "warning",
        description: "Status not available"
      }
    ].each do |stat| %>

      <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="small text-muted fw-semibold">
                <%= stat[:title] %>
              </span>

              <span class="badge bg-<%= stat[:colour] %>">
                HERGA
              </span>
            </div>

            <h2 class="fw-bold mb-1">
              <%= stat[:value] %>
            </h2>

            <p class="small text-muted mb-0">
              <%= stat[:description] %>
            </p>

          </div>
        </div>
      </div>

    <% end %>

  </div>

  <!-- CORPORATE USER DIRECTORY -->
  <div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <h5 class="fw-bold mb-1">
            Corporate User Directory
          </h5>
          <p class="small text-muted mb-0">
            Search by display name, username or email address.
          </p>
        </div>

        <span class="badge bg-primary px-3 py-2">
          HERGA.NET
        </span>
      </div>
    </div>

    <div class="card-body p-4">

      <!-- SEARCH FORM -->
      <%= form_with url: directory_users_path,
                    method: :get,
                    local: true,
                    class: "row g-2 mb-4" do %>

        <div class="col-12 col-md-8">
          <%= text_field_tag :q,
              @query,
              class: "form-control",
              maxlength: 100,
              autocomplete: "off",
              placeholder: "Enter name, username or email..." %>
        </div>

        <div class="col-6 col-md-2">
          <%= submit_tag "Search",
              class: "btn btn-primary w-100",
              name: nil %>
        </div>

        <div class="col-6 col-md-2">
          <%= link_to "Clear",
              directory_users_path,
              class: "btn btn-outline-secondary w-100" %>
        </div>

      <% end %>

      <!-- DIRECTORY ERROR -->
      <% if @directory_error %>

        <div class="alert alert-danger mb-0" role="alert">
          <h6 class="fw-bold mb-2">
            Directory Unavailable
          </h6>
          <p class="mb-0">
            Active Directory could not be queried.
            Verify the LDAPS connection and service account
            configuration before trying again.
          </p>
        </div>

      <!-- DIRECTORY RESULTS -->
      <% elsif users.any? %>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th scope="col">Display Name</th>
                <th scope="col">Username</th>
                <th scope="col">Email</th>
                <th scope="col">Department</th>
                <th scope="col">Account Status</th>
                <th scope="col" class="text-end">Action</th>
              </tr>
            </thead>

            <tbody>
              <% users.each do |user| %>

                <tr>
                  <!-- DISPLAY NAME -->
                  <td class="fw-semibold">
                    <%= user.display_name %>
                  </td>

                  <!-- USERNAME -->
                  <td>
                    <code><%= user.username %></code>
                  </td>

                  <!-- EMAIL -->
                  <td>
                    <% if user.email.present? %>
                      <%= mail_to user.email, user.email %>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>

                  <!-- DEPARTMENT -->
                  <td>
                    <%= user.department.presence || "—" %>
                  </td>

                  <!-- ACCOUNT STATUS -->
                  <td>
                    <% if user.enabled == true %>

                      <span class="badge bg-success">
                        Enabled
                      </span>

                    <% elsif user.enabled == false %>

                      <span class="badge bg-secondary">
                        Disabled
                      </span>

                    <% else %>

                      <span class="badge bg-warning text-dark">
                        Unknown
                      </span>

                    <% end %>
                  </td>

                  <!-- PROFILE LINK -->
                  <td class="text-end">
                    <%= link_to "View Profile",
                        directory_user_path(user.username),
                        class: "btn btn-outline-primary btn-sm" %>
                  </td>
                </tr>

              <% end %>
            </tbody>

          </table>
        </div>


        <!-- RESULTS SUMMARY -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">

          <span class="small text-muted">
            Showing
            <%= ((@current_page - 1) * 25) + 1 %>–<%= [@current_page * 25, @user_count].min %>
            of <%= @user_count %> returned users
          </span>

          <span class="small text-muted">
            Page <%= @current_page %> of <%= @total_pages %>
          </span>

        </div>

        <!-- PAGINATION -->
        <% if @total_pages > 1 %>

          <nav aria-label="Active Directory user pagination" class="mt-4">

            <ul class="pagination pagination-sm justify-content-center flex-wrap mb-0">

              <!-- PREVIOUS -->
              <li class="page-item <%= 'disabled' if @current_page == 1 %>">
                <% if @current_page > 1 %>
                  <%= link_to "Previous",
                      directory_users_path(q: @query.presence, page: @current_page - 1),
                      class: "page-link" %>
                <% else %>
                  <span class="page-link">Previous</span>
                <% end %>
              </li>

              <!-- PAGE NUMBERS -->
              <% (1..@total_pages).each do |page_number| %>

                <li class="page-item <%= 'active' if page_number == @current_page %>">

                  <%= link_to page_number,
                      directory_users_path(q: @query.presence, page: page_number),
                      class: "page-link",
                      aria: { current: (page_number == @current_page ? "page" : nil) } %>

                </li>

              <% end %>

              <!-- NEXT -->
              <li class="page-item <%= 'disabled' if @current_page == @total_pages %>">
                <% if @current_page < @total_pages %>
                  <%= link_to "Next",
                      directory_users_path(q: @query.presence, page: @current_page + 1),
                      class: "page-link" %>
                <% else %>
                  <span class="page-link">Next</span>
                <% end %>
              </li>

            </ul>

          </nav>

        <% end %>

        <% if @user_count >= 500 %>
          <p class="text-center text-muted small mt-3 mb-0">
            Directory results are currently limited to 500 accounts.
            Refine your search to locate additional users.
          </p>
        <% end %>




      <!-- NO RESULTS -->
      <% else %>

        <div class="text-center py-5">
          <h5 class="fw-bold mb-2">
            No Directory Users Found
          </h5>

          <p class="text-muted mb-3">
            No Active Directory accounts matched your search.
          </p>

          <%= link_to "Show Directory",
              directory_users_path,
              class: "btn btn-outline-primary" %>
        </div>

      <% end %>

    </div>
  </div>

  <!-- SECURITY NOTICE -->
  <div class="alert alert-secondary mt-4 mb-0">
    <strong>Security Notice:</strong>
    This directory is restricted to authorised HERGA Portal
    administrators. Information is retrieved from HERGA.NET
    Active Directory using read-only LDAP operations.
    Account modifications are not available through this interface.
  </div>

  <!-- FOOTER -->
  <div class="text-center text-muted small mt-4">
    HERGA Corporate Portal
    <span class="mx-2">|</span>
    Active Directory User Management
    <span class="mx-2">|</span>
    &copy; <%= Date.current.year %> HERGA
  </div>

</div>
