
<!DOCTYPE html>
<html lang="en">

  <head>

    <title>
      <%= content_for(:title) || "HERGA Corporate Portal" %>
    </title>

    <meta name="viewport"
          content="width=device-width,initial-scale=1">

    <meta name="apple-mobile-web-app-capable"
          content="yes">

    <meta name="application-name"
          content="HERGA Corporate Portal">

    <meta name="mobile-web-app-capable"
          content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon"
          href="/icon.png"
          type="image/png">

    <link rel="icon"
          href="/icon.svg"
          type="image/svg+xml">

    <link rel="apple-touch-icon"
          href="/icon.png">

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

  </head>

  <body>

    <%# ======================================================== %>
    <%# SHARED CORPORATE NAVIGATION                              %>
    <%# ======================================================== %>

    <%= render "layouts/header" %>

    <%# ======================================================== %>
    <%# FLASH MESSAGES                                          %>
    <%# ======================================================== %>

    <% if notice.present? || alert.present? %>

      <div class="container-fluid mt-3">

        <% if notice.present? %>

          <div class="alert alert-success alert-dismissible fade show"
               role="alert">

            <%= notice %>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

          </div>

        <% end %>

        <% if alert.present? %>

          <div class="alert alert-danger alert-dismissible fade show"
               role="alert">

            <%= alert %>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

          </div>

        <% end %>

      </div>

    <% end %>

    <%# ======================================================== %>
    <%# MAIN PAGE CONTENT                                       %>
    <%# ======================================================== %>

    <main id="main-content">

      <%= yield %>

    </main>

    <%# ======================================================== %>
    <%# CORPORATE FOOTER                                        %>
    <%# ======================================================== %>

    <% if user_signed_in? %>

      <footer class="text-center py-4 text-muted border-top">

        <small>

          HERGA.NET Corporate Services
          &copy; <%= Time.current.year %>

          <span class="mx-2">|</span>

          Authenticated as
          <strong>
            <%= current_user.username.presence ||
                "Portal User" %>
          </strong>

        </small>

      </footer>

    <% end %>

  </body>

</html>
