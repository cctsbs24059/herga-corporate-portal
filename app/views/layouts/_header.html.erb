
<%# ============================================================ %>
<%# HERGA CORPORATE PORTAL                                      %>
<%# Role-Aware Corporate Navigation - Bootstrap 5               %>
<%# Active Directory RBAC                                       %>
<%# ============================================================ %>

<% infrastructure_access = user_signed_in? && portal_can?(:infrastructure_read) %>
<% infrastructure_management = user_signed_in? && portal_can?(:infrastructure_manage) %>
<% governance_access = user_signed_in? && portal_can?(:governance_read) %>
<% governance_management = user_signed_in? && portal_can?(:governance_manage) %>
<% governance_evidence = user_signed_in? && portal_can?(:governance_evidence_read) %>
<% application_management = user_signed_in? && portal_can?(:portal_applications_manage) %>

<% role_labels = {
  portal_admin: "Portal Administrator",
  infrastructure_admin: "Infrastructure Administrator",
  security_admin: "Security Administrator",
  auditor: "Auditor",
  employee: "Employee"
} %>

<% assigned_roles = user_signed_in? ? Array(current_portal_roles) : [] %>
<% assigned_role_labels = assigned_roles.filter_map { |role| role_labels[role] } %>

<nav class="navbar navbar-expand-lg navbar-dark"
     style="background-color:#243b55;">

  <div class="container-fluid">

    <%# CORPORATE BRAND %>

    <%= link_to root_path,
                class: "navbar-brand fw-bold d-flex align-items-center gap-2" do %>
      <i class="bi bi-buildings"></i>
      <span>HERGA CORPORATE</span>
    <% end %>

    <%# MOBILE NAVIGATION %>

    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#hergaNavbar"
            aria-controls="hergaNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="hergaNavbar">

      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <%# DASHBOARD %>

        <li class="nav-item">
          <%= link_to root_path, class: "nav-link" do %>
            <i class="bi bi-speedometer2 me-1"></i>
            Dashboard
          <% end %>
        </li>

        <%# CORPORATE APPLICATIONS %>

        <% if user_signed_in? && portal_can?(:portal_read) %>
          <li class="nav-item">
            <%= link_to portal_applications_path,
                        class: "nav-link" do %>
              <i class="bi bi-grid me-1"></i>
              Applications
            <% end %>
          </li>
        <% end %>

        <%# INFRASTRUCTURE %>

        <% if infrastructure_access %>
          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               id="infrastructureDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
              <i class="bi bi-hdd-network me-1"></i>
              Infrastructure
            </a>

            <ul class="dropdown-menu"
                aria-labelledby="infrastructureDropdown">

              <li>
                <%= link_to infrastructure_monitoring_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-activity me-2"></i>
                  Monitoring Dashboard
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_assets_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-hdd-network me-2"></i>
                  Asset Inventory
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_incidents_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  Incident Register
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_availability_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-bar-chart-line me-2"></i>
                  Availability
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_availability_alerts_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-bell me-2"></i>
                  Availability Alerts
                <% end %>
              </li>

              <li><hr class="dropdown-divider"></li>

              <li>
                <%= link_to infrastructure_operational_reports_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-file-earmark-text me-2"></i>
                  Operational Reports
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_analytics_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-graph-up me-2"></i>
                  Infrastructure Analytics
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_executive_dashboard_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-speedometer me-2"></i>
                  Executive Dashboard
                <% end %>
              </li>

              <% if infrastructure_management %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to new_infrastructure_asset_path,
                              class: "dropdown-item" do %>
                    <i class="bi bi-plus-circle me-2"></i>
                    Register Asset
                  <% end %>
                </li>
              <% end %>

            </ul>
          </li>
        <% end %>

        <%# GOVERNANCE %>

        <% if governance_access %>
          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               id="governanceDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
              <i class="bi bi-shield-check me-1"></i>
              Governance
            </a>

            <ul class="dropdown-menu"
                aria-labelledby="governanceDropdown">

              <li>
                <%= link_to infrastructure_notifications_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-bell me-2"></i>
                  Notification Centre
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_analytics_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-graph-up me-2"></i>
                  Notification Analytics
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_reports_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-file-earmark-bar-graph me-2"></i>
                  Notification Reports
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_operations_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-gear me-2"></i>
                  Notification Operations
                <% end %>
              </li>

              <li><hr class="dropdown-divider"></li>

              <li>
                <%= link_to infrastructure_notification_retention_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-archive me-2"></i>
                  Retention Overview
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_retention_policies_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-journal-check me-2"></i>
                  Retention Policies
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_legal_holds_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-lock me-2"></i>
                  Legal Holds
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_governance_security_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-shield-lock me-2"></i>
                  Governance Security
                <% end %>
              </li>

              <li>
                <%= link_to infrastructure_notification_governance_compliance_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-clipboard-check me-2"></i>
                  Compliance Dashboard
                <% end %>
              </li>

              <% if governance_evidence %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to infrastructure_notification_governance_evidence_bundle_path,
                              class: "dropdown-item" do %>
                    <i class="bi bi-download me-2"></i>
                    Download Evidence Bundle
                  <% end %>
                </li>
              <% end %>

              <% if governance_management %>
                <li><hr class="dropdown-divider"></li>

                <li>
                  <%= link_to new_infrastructure_notification_retention_policy_path,
                              class: "dropdown-item" do %>
                    <i class="bi bi-plus-circle me-2"></i>
                    Create Retention Policy
                  <% end %>
                </li>

                <li>
                  <%= link_to new_infrastructure_notification_legal_hold_path,
                              class: "dropdown-item" do %>
                    <i class="bi bi-lock-fill me-2"></i>
                    Register Legal Hold
                  <% end %>
                </li>
              <% end %>

            </ul>
          </li>
        <% end %>

        <%# APPLICATION ADMINISTRATION %>

        <% if application_management %>
          <li class="nav-item dropdown">

            <a class="nav-link dropdown-toggle"
               href="#"
               id="administrationDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
              <i class="bi bi-sliders me-1"></i>
              Administration
            </a>

            <ul class="dropdown-menu"
                aria-labelledby="administrationDropdown">

              <li>
                <%= link_to admin_portal_applications_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-grid-3x3-gap me-2"></i>
                  Manage Applications
                <% end %>
              </li>

              <li>
                <%= link_to new_admin_portal_application_path,
                            class: "dropdown-item" do %>
                  <i class="bi bi-plus-circle me-2"></i>
                  Add Application
                <% end %>
              </li>

            </ul>
          </li>
        <% end %>

      </ul>

      <%# AUTHENTICATED USER ACCOUNT %>

      <% if user_signed_in? %>

        <div class="d-flex flex-wrap align-items-center gap-3">

          <span class="navbar-text text-white-50 small d-none d-xl-inline">
            HERGA.NET Enterprise Services
          </span>

          <div class="dropdown">

            <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    id="hergaUserDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

              <i class="bi bi-person-circle fs-5"></i>

              <span class="text-start">

                <span class="d-block fw-semibold">
                  <%= current_user.username.presence || "Authenticated User" %>
                </span>

                <span class="d-block"
                      style="font-size:10px;opacity:.8;">
                  HERGA.NET
                  <% if assigned_role_labels.any? %>
                    | <%= assigned_role_labels.join(", ") %>
                  <% end %>
                </span>

              </span>

            </button>

            <ul class="dropdown-menu dropdown-menu-end"
                aria-labelledby="hergaUserDropdown">

              <li class="dropdown-header">
                <div class="fw-semibold">
                  <%= current_user.username.presence || "Authenticated User" %>
                </div>
                <div class="small text-muted">HERGA.NET</div>
              </li>

              <li><hr class="dropdown-divider"></li>

              <li>
                <span class="dropdown-item-text small text-muted">
                  <i class="bi bi-shield-check me-2"></i>
                  <%= assigned_role_labels.presence&.join(", ") ||
                      "Directory Access Unverified" %>
                </span>
              </li>

              <li><hr class="dropdown-divider"></li>

              <li>
                <%= button_to destroy_user_session_path,
                              method: :delete,
                              class: "dropdown-item text-danger",
                              form: { class: "m-0" } do %>
                  <i class="bi bi-box-arrow-right me-2"></i>
                  Sign Out
                <% end %>
              </li>

            </ul>

          </div>
        </div>

      <% else %>

        <%= link_to new_user_session_path,
                    class: "btn btn-outline-light btn-sm" do %>
          <i class="bi bi-box-arrow-in-right me-1"></i>
          Sign In
        <% end %>

      <% end %>

    </div>
  </div>
</nav>
