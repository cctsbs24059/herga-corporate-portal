
<%# ============================================== %>
<%# HERGA CORPORATE PORTAL - NAVIGATION HEADER     %>
<%# Bootstrap 5                                    %>
<%# ============================================== %>

<%# Main corporate navigation bar. %>
<nav class="navbar navbar-expand-lg navbar-dark"
     style="background-color:#243b55;">

  <div class="container-fluid">

    <%# Corporate brand and homepage link. %>
    <%= link_to "HERGA CORPORATE",
        root_path,
        class: "navbar-brand fw-bold" %>

    <%# Mobile navigation toggle button. %>
    <button class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#hergaNavbar"
            aria-controls="hergaNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">

      <span class="navbar-toggler-icon"></span>

    </button>

    <%# Collapsible navigation menu. %>
    <div class="collapse navbar-collapse"
         id="hergaNavbar">

      <%# Main application navigation links. %>
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <%# Dashboard link. %>
        <li class="nav-item">

          <%= link_to "Dashboard",
              root_path,
              class: "nav-link" %>

        </li>

        <%# Corporate application directory link. %>
        <li class="nav-item">

          <%= link_to "Applications",
              portal_applications_path,
              class: "nav-link" %>

        </li>

      </ul>

      <%# Corporate network identification. %>
      <span class="navbar-text text-white">

        HERGA.NET Enterprise Services

      </span>

    </div>

  </div>

</nav>
