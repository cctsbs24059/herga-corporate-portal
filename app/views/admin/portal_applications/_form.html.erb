
<%= form_with model: [:admin, portal_application] do |form| %>

  <% if portal_application.errors.any? %>
    <div class="alert alert-danger">
      <strong>
        Please correct the following errors:
      </strong>
      <ul class="mb-0 mt-2">
        <% portal_application.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label fw-semibold" %>
    <%= form.text_field :name,
                        class: "form-control",
                        required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label fw-semibold" %>
    <%= form.text_area :description,
                       class: "form-control",
                       rows: 3 %>
  </div>

  <div class="mb-3">
    <%= form.label :url, "Application URL",
                   class: "form-label fw-semibold" %>
    <%= form.url_field :url,
                       class: "form-control",
                       placeholder: "https://application.herga.net" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :category, class: "form-label fw-semibold" %>
      <%= form.text_field :category, class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :icon, "Bootstrap Icon",
                     class: "form-label fw-semibold" %>
      <%= form.text_field :icon,
                          class: "form-control",
                          placeholder: "bi-grid" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :position, class: "form-label fw-semibold" %>
      <%= form.number_field :position, class: "form-control" %>
    </div>

    <div class="col-md-6 mb-3 d-flex align-items-center">
      <div class="form-check mt-4">
        <%= form.check_box :active, class: "form-check-input" %>
        <%= form.label :active, "Application Active",
                       class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>

    <%= link_to "Cancel",
                admin_portal_applications_path,
                class: "btn btn-outline-secondary" %>
  </div>

<% end %>
