
<% content_for :title, "Edit Application | HERGA" %>

<div class="container py-4">

  <div class="mb-4">
    <h2 class="fw-bold">
      <i class="bi bi-pencil-square me-2"></i>
      Edit Corporate Application
    </h2>
    <p class="text-muted">
      Update <strong><%= @portal_application.name %></strong>.
    </p>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <%= render "form",
                 portal_application: @portal_application %>
    </div>
  </div>

</div>
