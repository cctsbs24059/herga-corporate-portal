
<% content_for :title, "Application Administration | HERGA" %>

<div class="container-fluid py-4">

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h2 class="fw-bold mb-1">
        <i class="bi bi-grid-3x3-gap me-2"></i>
        Application Administration
      </h2>
      <p class="text-muted mb-0">
        Manage applications registered in the HERGA Corporate Portal.
      </p>
    </div>

    <%= link_to new_admin_portal_application_path,
                class: "btn btn-primary" do %>
      <i class="bi bi-plus-circle me-2"></i>
      Add Application
    <% end %>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold py-3">
      Registered Applications
      <span class="badge bg-secondary ms-2">
        <%= @portal_applications.size %>
      </span>
    </div>

    <div class="card-body p-0">

      <% if @portal_applications.any? %>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Application</th>
                <th>Category</th>
                <th>Status</th>
                <th>Position</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @portal_applications.each do |application| %>
                <tr>
                  <td>
                    <div class="fw-semibold">
                      <%= application.name %>
                    </div>
                    <div class="small text-muted">
                      <%= application.description %>
                    </div>
                  </td>

                  <td>
                    <%= application.category.presence || "Uncategorised" %>
                  </td>

                  <td>
                    <% if application.active? %>
                      <span class="badge bg-success">Active</span>
                    <% else %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% end %>
                  </td>

                  <td><%= application.position %></td>

                  <td class="text-end">
                    <div class="d-inline-flex gap-2">

                      <%= link_to edit_admin_portal_application_path(application),
                                  class: "btn btn-sm btn-outline-primary",
                                  title: "Edit application",
                                  aria: { label: "Edit #{application.name}" } do %>
                        <i class="bi bi-pencil-square"></i>
                      <% end %>

                      <%= button_to admin_portal_application_path(application),
                                    method: :delete,
                                    class: "btn btn-sm btn-outline-danger",
                                    form: {
                                      class: "d-inline",
                                      data: {
                                        turbo_confirm: "Remove #{application.name}?"
                                      }
                                    },
                                    title: "Remove application",
                                    aria: { label: "Remove #{application.name}" } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>

                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

      <% else %>

        <div class="text-center py-5">
          <i class="bi bi-grid fs-1 text-muted"></i>
          <h5 class="mt-3">No applications registered</h5>
          <p class="text-muted">
            Add your first corporate application.
          </p>
        </div>

      <% end %>

    </div>
  </div>

</div>
